# Ignore everything by default
/*

# But allow the .gitignore file itself
!.gitignore

# Allow the dofiles/ folder and everything inside it
!/dofiles/
!/dofiles/**

# Allow the logfiles/ folder and everything inside it
!/logfiles/
!/logfiles/**

# Allow the graphs/ folder and everything inside it
!/graphs/
!/graphs/**

# Allow project documentation
!/README.md
!/CLAUDE.md
!/main_graphs.tex
!/nota_drift.tex
!/slides_drift.pptx
!/make_slides_drift.js

# Allow also all figures
!/graphs/
!/graphs/**

# Stata swap files
/dofiles/~*.stswp

# Windows thumbnail cache
Thumbs.db
